# Local development: copy the values you need into `.env.local` at the repo
# root — it is gitignored and symlinked into apps/control-plane so the Next
# app loads it. Do not create a root `.env`; nothing reads it. Set only the
# values you actually use: blank values are treated as absent, and omitting
# a variable is always safer than leaving it empty.

# Public origin used when the control plane generates absolute URLs.
AGENTOS_PUBLIC_URL=http://localhost:3000

# OAuth is restricted to this exact GitHub login. Use a 32+ byte random session secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=
AGENTOS_SESSION_SECRET=

# Separate server-side token used by CLI callers. Never expose it to browser code.
AGENTOS_CLI_TOKEN=

# CLI connection settings. AGENTOS_API_TOKEN should carry the same secret as the
# server's AGENTOS_CLI_TOKEN, but only in the operator's shell/secret manager.
AGENTOS_URL=http://localhost:3000
AGENTOS_API_TOKEN=

# Choose memory explicitly for local development/tests. Production must use neon.
AGENTOS_REPOSITORY=memory
DATABASE_URL=

# Trigger.dev v4 durable workflow coordination. The secret and project ref are
# server-only. The browser never receives waitpoint completion tokens.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Add provider credentials only to local environment files or a secret manager.
# Never commit secrets to this repository.
ANTHROPIC_API_KEY=
# Moonshot Kimi runtime. Sessions run in a local process sandbox on the
# worker; the key is required only when a model profile routes to kimi.
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/anthropic
# AGENTOS_KIMI_SANDBOX_ROOT=/var/tmp/agentos-kimi
# Stable 32+ byte secret for deterministic Managed Agents session ownership.
AGENTOS_RUNTIME_OWNERSHIP_SECRET=
# Base64url-encoded 32-byte AES key for sealed persisted runtime handles.
AGENTOS_RUNTIME_HANDLE_KEY=
# JSON map from exact agent-reported test command to trusted executable/argv.
AGENTOS_TRUSTED_TEST_COMMANDS_JSON={"pnpm test":{"executable":"pnpm","arguments":["test"]}}
# Exact package registry hosts reachable only by the secretless verification
# sandbox for its trusted frozen-lockfile install (lifecycle scripts disabled).
# Managed Agents' broad package-manager registry bypass remains disabled.
AGENTOS_VERIFICATION_REGISTRY_HOSTS_JSON=["registry.npmjs.org"]
# Rotating HMAC keys for bounded trusted test-report attestations.
AGENTOS_TEST_REPORT_KEYS_JSON=[]

# Publisher-only GitHub App credentials. This identity can mint the bounded
# contents/PR-write token used only by the trusted publisher.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# A distinct GitHub App identity with Contents: read and no write permissions.
GITHUB_READER_APP_ID=
GITHUB_READER_APP_PRIVATE_KEY=
# Rotating HMAC authorization keys: [{"keyId":"publisher-2026-08","secret":"..."}]
GITHUB_PUBLICATION_KEYS_JSON=[]
# POC: exactly one selected GitHub App repository binding.
GITHUB_SELECTED_REPOSITORIES_JSON=[]
GITHUB_READER_SELECTED_REPOSITORIES_JSON=[]

# Live Managed Agents smoke tests are destructive to remote session state and
# stay disabled unless this exact opt-in is set alongside ANTHROPIC_API_KEY.
AGENTOS_LIVE_TESTS=0

# Artifact MCP uses an R2 key whose bucket policy permits only GetObject and
# PutObject. Never grant ListBucket or DeleteObject to this credential.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ARTIFACT_BUCKET=
CLOUDFLARE_R2_ARTIFACT_ACCESS_KEY_ID=
CLOUDFLARE_R2_ARTIFACT_SECRET_ACCESS_KEY=
# Optional Cloudflare jurisdiction: default, eu, or fedramp.
CLOUDFLARE_R2_JURISDICTION=default
# Optional, separate control-plane-only credentials for retention deletion.
CLOUDFLARE_R2_ADMIN_ACCESS_KEY_ID=
CLOUDFLARE_R2_ADMIN_SECRET_ACCESS_KEY=
# Vercel Cron authenticates the durable hourly cleanup route with this 32+
# byte server-side secret.
CRON_SECRET=

# JSON array of rotating HMAC keys, each with a unique keyId and a 32+ byte
# secret. Keep an old verification key during capability rotation.
ARTIFACT_CAPABILITY_KEYS_JSON=[]
# Public HTTPS URL of the scoped Artifact MCP endpoint. Managed sessions receive
# a vault reference for its per-step bearer capability, never the raw token.
AGENTOS_ARTIFACT_MCP_URL=
# Comma-separated exact origins allowed to call the Streamable HTTP endpoint.
ARTIFACT_MCP_ALLOWED_ORIGINS=http://localhost:3000
