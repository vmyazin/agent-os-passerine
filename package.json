{
  "name": "agent-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "agentos": "pnpm --silent --filter @agentos/cli... build && node apps/cli/dist/index.js",
    "build": "turbo run build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @agentos/adapters test:integration",
    "test:e2e": "pnpm build && playwright test",
    "trigger:deploy": "trigger deploy",
    "trigger:dev": "trigger dev",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@trigger.dev/sdk": "4.5.11",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "trigger.dev": "4.5.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
